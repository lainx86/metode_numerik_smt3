% --- SKENARIO 1: Simulasi Difusi 1D (FTCS) ---
clear; clc; close all;

NIM = [0, 8, 7];

% 1. INPUT PARAMETER (Sesuai Tabel Skenario 1 & NIM 087)
L = 3000;           % Panjang kanal (m)
dx = 30;            % Lebar grid (m)
T_total = 7200;     % Lama simulasi (detik)
dt = 6;             % Langkah waktu (detik)
G = 0.05;           % Koefisien difusi (m^2/detik)
z = NIM7;              % Digit terakhir NIM

% Hitung Konstanta
Source_Conc = 10 * z;       % Konsentrasi polutan (mg/l) -> 70
Source_Grid = 30 + z;       % Grid sumber polutan kontinu -> 37

% 2. INISIALISASI GRID (Sesuai Flowchart)
imax = round(L / dx);       % Jumlah grid ruang
nmax = round(T_total / dt); % Jumlah langkah waktu

% Membuat matriks konsentrasi C(waktu, ruang)
% Baris = waktu (n), Kolom = ruang (i)
C = zeros(nmax, imax); 

% Konstanta stabilitas difusi (alpha)
alpha = (G * dt) / (dx^2);

% Cek Stabilitas (Syarat: alpha <= 0.5)
fprintf('Nilai Alpha: %.4f (Stabil jika <= 0.5)\n', alpha);

% 3. LOOPING UTAMA (Iterasi Waktu dan Ruang)
for n = 1 : nmax - 1
    
    % --- Syarat Sumber Kontinu ---
    % Memastikan grid sumber selalu bernilai konstan setiap waktu
    C(n, Source_Grid) = Source_Conc; 
    
    % Looping Ruang (Interior nodes)
    for i = 2 : imax - 1
        % Persamaan Difusi FTCS sesuai flowchart
        % C(n+1, i) = C(n,i) + alpha * (C(n,i+1) - 2*C(n,i) + C(n,i-1))
        C(n+1, i) = C(n, i) + alpha * (C(n, i+1) - 2 * C(n, i) + C(n, i-1));
    end
    
    % --- Syarat Batas (Boundary Conditions) ---
    % Ujung kiri dan kanan dianggap 0 (atau tetap mengikuti perhitungan sebelumnya)
    C(n+1, 1) = 0;      
    C(n+1, imax) = 0;
    
    % Memastikan sumber tetap menyala untuk langkah selanjutnya (kontinu)
    C(n+1, Source_Grid) = Source_Conc;
end

% 4. OUTPUT GRAFIK

% Buat vector jarak dan waktu untuk label
x_vec = 0:dx:(imax-1)*dx;
t_vec = 0:dt:(nmax-1)*dt;

% --- Grafik 1: Konsentrasi vs Ruang (5 Grid Waktu yang mewakili) ---
figure(1);
hold on;
plot_times = round(linspace(1, nmax, 5)); % Pilih 5 waktu secara merata
labels_time = {};

for k = 1:length(plot_times)
    t_idx = plot_times(k);
    plot(x_vec, C(t_idx, :), 'LineWidth', 1.5);
    labels_time{k} = sprintf('t = %.0f s', t_vec(t_idx));
end
title(['Skenario 1: Konsentrasi Polutan terhadap Ruang (L=', num2str(L), ')']);
xlabel('Jarak (meter)');
ylabel('Konsentrasi (mg/l)');
legend(labels_time);
grid on;
hold off;

% --- Grafik 2: Konsentrasi vs Waktu (5 Grid Ruang yang mewakili) ---
% Kita ambil 5 titik: Sumber, dan 4 titik di sebelah kanan sumber (hilir)
target_grids = [Source_Grid, Source_Grid+5, Source_Grid+10, Source_Grid+20, Source_Grid+40];
% Pastikan tidak melebihi imax
target_grids = target_grids(target_grids < imax);

figure(2);
hold on;
labels_grid = {};
for k = 1:length(target_grids)
    g_idx = target_grids(k);
    plot(t_vec, C(:, g_idx), 'LineWidth', 1.5);
    labels_grid{k} = sprintf('Grid %d (x=%.0fm)', g_idx, x_vec(g_idx));
end
title('Skenario 1: Konsentrasi Polutan terhadap Waktu');
xlabel('Waktu (detik)');
ylabel('Konsentrasi (mg/l)');
legend(labels_grid, 'Location', 'Southeast');
grid on;
hold off;